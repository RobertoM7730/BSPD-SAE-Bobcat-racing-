	(text "Comparator used :TLV1824\nLogic same as above but U4A measure brake force limits is about 20% look\nat rule book to confirm \n\nSame logic as U3B and C for U4B and C except for Brake force wire"
		(exclude_from_sim no)
		(at -45.72 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "7471d8bf-9a9c-474c-8b42-a4e039b6059b")
	)
	(text "Comparator used :TLV1824\nLogic explained U3A is what will be used to compare the actual signal\nlevel with U4A. If U3A outputs high that means we have reached 5KW demand \nPer Rule book limits\n\nWhile U3B and U3C are wired the opposite way both will output high if\nthere conditions arent met. when they pull low this indicates a problem\nwith the wiring which will shutdown the car instantly\n"
		(exclude_from_sim no)
		(at -46.228 64.008 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "788969ea-324a-4bd4-8d95-4e87adcf6c85")
	)
	(text "Reads High when everything is reading good\n\nReads Low when/ if faults in sensors\n"
		(exclude_from_sim no)
		(at 340.614 228.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a792b59a-f73c-4dd7-853d-ecccc269b5bd")
	)
